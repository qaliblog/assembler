{
  "name": "@assembler/project-modifier",
  "version": "0.1.0",
  "description": "Safe, deterministic modification of projects generated by Assembler: planned changes, AST-guided patches, backups, verification and rollback.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@assembler/core": "workspace:*",
    "@assembler/environment-manager": "workspace:*",
    "@assembler/project-spec": "workspace:*",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@types/node": "18.19.50",
    "vitest": "2.1.9"
  }
}
