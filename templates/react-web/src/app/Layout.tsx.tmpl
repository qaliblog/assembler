import type { ReactNode } from 'react';
import { routeEntries } from './routes';
import { Link, useLocationPath } from './router';
import { useAuth } from './AuthProvider';
import styles from './Layout.module.css';

export const layoutMode = '{{layoutMode}}' as const;

export function Layout({ children }: { children: ReactNode }) {
  const pathname = useLocationPath();
  const { user, logout } = useAuth();
  const primaryRoutes = routeEntries.filter((entry) => !entry.requiresAuth || user !== null);

  return (
    <div className={styles.shell} data-layout={layoutMode}>
      <header className={styles.header}>
        <Link to="/" className={styles.brand}>
          {{appTitle}}
        </Link>
        <nav className={styles.nav} aria-label="Primary">
          {primaryRoutes.map((entry) => (
            <Link
              key={entry.path}
              to={entry.path}
              className={styles.navLink}
              aria-current={pathname === entry.path ? 'page' : undefined}
            >
              {entry.title}
            </Link>
          ))}
        </nav>
        <div className={styles.account}>
          {user === null ? (
            <Link to="/login" className={styles.accountLink}>
              Sign in
            </Link>
          ) : (
            <>
              <span className={styles.user}>{user.email}</span>
              <button type="button" className={styles.signOut} onClick={logout}>
                Sign out
              </button>
            </>
          )}
        </div>
      </header>
      <main className={styles.main} id="main-content">
        {children}
      </main>
      <footer className={styles.footer}>
        <span>{{projectName}}</span>
        <span>Generated by Assembler. {{theme}} theme.</span>
      </footer>
    </div>
  );
}
