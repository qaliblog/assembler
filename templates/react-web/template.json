{
  "id": "react-web-vite",
  "version": "1.0.0",
  "description": "React 18 + TypeScript + Vite single-page application with a verified component set, router, auth provider, API client and Vitest tests.",
  "framework": "react",
  "buildSystem": "vite",
  "variables": [
    { "name": "appTitle", "description": "Human-readable application title", "example": "Demo Dashboard" },
    { "name": "projectName", "description": "Project name used in copy", "example": "demo-dashboard" },
    { "name": "theme", "description": "Active theme (dark/light)", "example": "dark" },
    { "name": "layout", "description": "Layout variant", "example": "dashboard" },
    { "name": "apiBaseUrl", "description": "Base URL for API calls", "example": "/api" }
  ],
  "files": [
    { "source": "index.html.tmpl", "target": "index.html", "mode": "render", "kind": "config" },
    { "source": "tsconfig.json", "target": "tsconfig.json", "mode": "copy", "kind": "config" },
    { "source": "tsconfig.node.json", "target": "tsconfig.node.json", "mode": "copy", "kind": "config" },
    { "source": "vite.config.ts", "target": "vite.config.ts", "mode": "copy", "kind": "config" },
    { "source": "vitest.config.ts", "target": "vitest.config.ts", "mode": "copy", "kind": "config" },
    { "source": "vitest.setup.ts", "target": "vitest.setup.ts", "mode": "copy", "kind": "test" },
    { "source": "src/main.tsx", "target": "src/main.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/vite-env.d.ts", "target": "src/vite-env.d.ts", "mode": "copy", "kind": "config" },
    { "source": "src/App.tsx", "target": "src/App.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/app/router.tsx", "target": "src/app/router.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/app/router.test.tsx", "target": "src/app/router.test.tsx", "mode": "copy", "kind": "test" },
    { "source": "src/app/routes.tsx.tmpl", "target": "src/app/routes.tsx", "mode": "render", "kind": "source" },
    { "source": "src/app/Layout.tsx.tmpl", "target": "src/app/Layout.tsx", "mode": "render", "kind": "source" },
    { "source": "src/app/Layout.module.css", "target": "src/app/Layout.module.css", "mode": "copy", "kind": "style" },
    { "source": "src/app/AuthProvider.tsx", "target": "src/app/AuthProvider.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/app/AuthProvider.test.tsx", "target": "src/app/AuthProvider.test.tsx", "mode": "copy", "kind": "test" },
    { "source": "src/components/Button.tsx", "target": "src/components/Button.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/components/Button.module.css", "target": "src/components/Button.module.css", "mode": "copy", "kind": "style" },
    { "source": "src/components/Button.test.tsx", "target": "src/components/Button.test.tsx", "mode": "copy", "kind": "test" },
    { "source": "src/components/Card.tsx", "target": "src/components/Card.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/components/Card.module.css", "target": "src/components/Card.module.css", "mode": "copy", "kind": "style" },
    { "source": "src/components/Card.test.tsx", "target": "src/components/Card.test.tsx", "mode": "copy", "kind": "test" },
    { "source": "src/components/TextField.tsx", "target": "src/components/TextField.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/components/TextField.module.css", "target": "src/components/TextField.module.css", "mode": "copy", "kind": "style" },
    { "source": "src/components/States.tsx", "target": "src/components/States.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/components/States.module.css", "target": "src/components/States.module.css", "mode": "copy", "kind": "style" },
    { "source": "src/components/States.test.tsx", "target": "src/components/States.test.tsx", "mode": "copy", "kind": "test" },
    { "source": "src/components/PageHeader.tsx", "target": "src/components/PageHeader.tsx", "mode": "copy", "kind": "source" },
    { "source": "src/components/PageHeader.module.css", "target": "src/components/PageHeader.module.css", "mode": "copy", "kind": "style" },
    { "source": "src/lib/api.ts", "target": "src/lib/api.ts", "mode": "copy", "kind": "source" },
    { "source": "src/lib/api.test.ts", "target": "src/lib/api.test.ts", "mode": "copy", "kind": "test" },
    { "source": "src/lib/validation.ts", "target": "src/lib/validation.ts", "mode": "copy", "kind": "source" },
    { "source": "src/lib/validation.test.ts", "target": "src/lib/validation.test.ts", "mode": "copy", "kind": "test" },
    { "source": "src/hooks/useAsync.ts", "target": "src/hooks/useAsync.ts", "mode": "copy", "kind": "source" },
    { "source": "src/hooks/useAsync.test.tsx", "target": "src/hooks/useAsync.test.tsx", "mode": "copy", "kind": "test" },
    { "source": "src/styles/global.css", "target": "src/styles/global.css", "mode": "copy", "kind": "style" },
    { "source": "src/styles/tokens.css.tmpl", "target": "src/styles/tokens.css", "mode": "render", "kind": "style" },
    { "source": "pages/login.tsx.tmpl", "target": "src/pages/LoginPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/register.tsx.tmpl", "target": "src/pages/RegisterPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/dashboard.tsx.tmpl", "target": "src/pages/DashboardPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/settings.tsx.tmpl", "target": "src/pages/SettingsPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/profile.tsx.tmpl", "target": "src/pages/ProfilePage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/landing.tsx.tmpl", "target": "src/pages/LandingPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/list.tsx.tmpl", "target": "src/pages/ListPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/detail.tsx.tmpl", "target": "src/pages/DetailPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/generic.tsx.tmpl", "target": "src/pages/GenericPage.tsx", "mode": "render", "kind": "source" },
    { "source": "pages/page.test.tsx.tmpl", "target": "src/pages/Page.test.tsx", "mode": "render", "kind": "test" },
    { "source": "README.md.tmpl", "target": "README.md", "mode": "render", "kind": "documentation" }
  ]
}
