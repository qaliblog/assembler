import { useState, type FormEvent } from 'react';
import { useAuth } from '../app/AuthProvider';
import { Button } from '../components/Button';
import { PageHeader } from '../components/PageHeader';
import { TextField } from '../components/TextField';
import { validateField } from '../lib/validation';

const DISPLAY_NAME_KEY = 'assembler.settings.displayName';

function readDisplayName(): string {
  try {
    return window.localStorage.getItem(DISPLAY_NAME_KEY) ?? '';
  } catch {
    return '';
  }
}

export function {{componentName}}() {
  const { user } = useAuth();
  const [displayName, setDisplayName] = useState(readDisplayName);
  const [error, setError] = useState<string | null>(null);
  const [saved, setSaved] = useState(false);

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const validationError = validateField(displayName, { maxLength: 60 });
    setError(validationError);
    if (validationError !== null) return;
    try {
      window.localStorage.setItem(DISPLAY_NAME_KEY, displayName);
    } catch {
      // Storage is optional; the message below still confirms the submit.
    }
    setSaved(true);
  }

  return (
    <section>
      <PageHeader title="{{pageTitle}}" description="Preferences are stored locally in this browser." />
      <form className="stack" onSubmit={handleSubmit} noValidate aria-label="Settings form">
        <TextField
          label="Display name"
          name="displayName"
          value={displayName}
          onChange={(event) => {
            setDisplayName(event.target.value);
            setSaved(false);
          }}
          hint={user === null ? 'You are not signed in' : `Signed in as ${user.email}`}
          {...(error === null ? {} : { error })}
        />
        <Button type="submit">Save preferences</Button>
        <p role="status">{saved ? 'Preferences saved.' : ''}</p>
      </form>
    </section>
  );
}
