{
  "id": "node-blog-server",
  "version": "1.0.0",
  "description": "Server-rendered editorial blog on Node.js + TypeScript: layered router, controllers, content service, professional design system, RSS and a full route/links regression suite.",
  "framework": "node-typescript",
  "buildSystem": "tsc",
  "variables": [
    { "name": "appTitle", "description": "Publication title", "example": "The Quiet Page" },
    { "name": "projectName", "description": "Project name used in copy", "example": "quiet-page" },
    { "name": "tagline", "description": "Short line shown in the footer", "example": "Essays on software craft and design" },
    { "name": "siteDescription", "description": "Meta description and about-page lede", "example": "An independent publication about building software with care." },
    { "name": "contactEmail", "description": "Published contact address", "example": "editor@example.com" },
    { "name": "theme", "description": "Active theme (dark/light)", "example": "dark" }
  ],
  "files": [
    { "source": "tsconfig.json", "target": "tsconfig.json", "mode": "copy", "kind": "config" },
    { "source": "tsconfig.build.json", "target": "tsconfig.build.json", "mode": "copy", "kind": "config" },
    { "source": "vitest.config.ts", "target": "vitest.config.ts", "mode": "copy", "kind": "config" },
    { "source": "src/domain/post.ts", "target": "src/domain/post.ts", "mode": "copy", "kind": "source" },
    { "source": "src/content/posts.ts", "target": "src/content/posts.ts", "mode": "copy", "kind": "source" },
    { "source": "src/services/content.ts", "target": "src/services/content.ts", "mode": "copy", "kind": "source" },
    { "source": "src/lib/html.ts", "target": "src/lib/html.ts", "mode": "copy", "kind": "source" },
    { "source": "src/lib/http.ts", "target": "src/lib/http.ts", "mode": "copy", "kind": "source" },
    { "source": "src/lib/logger.ts", "target": "src/lib/logger.ts", "mode": "copy", "kind": "source" },
    { "source": "src/lib/slug.ts", "target": "src/lib/slug.ts", "mode": "copy", "kind": "source" },
    { "source": "src/router/router.ts", "target": "src/router/router.ts", "mode": "copy", "kind": "source" },
    { "source": "src/router/routes.ts", "target": "src/router/routes.ts", "mode": "copy", "kind": "source" },
    { "source": "src/routes/pages.ts", "target": "src/routes/pages.ts", "mode": "copy", "kind": "source" },
    { "source": "src/routes/api.ts", "target": "src/routes/api.ts", "mode": "copy", "kind": "source" },
    { "source": "src/middleware/security.ts", "target": "src/middleware/security.ts", "mode": "copy", "kind": "source" },
    { "source": "src/middleware/logging.ts", "target": "src/middleware/logging.ts", "mode": "copy", "kind": "source" },
    { "source": "src/middleware/errors.ts", "target": "src/middleware/errors.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/layout.ts", "target": "src/views/layout.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/components.ts", "target": "src/views/components.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/home.ts", "target": "src/views/home.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/archive.ts", "target": "src/views/archive.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/post.ts", "target": "src/views/post.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/pages.ts", "target": "src/views/pages.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/errors.ts", "target": "src/views/errors.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/feed.ts", "target": "src/views/feed.ts", "mode": "copy", "kind": "source" },
    { "source": "src/views/styles.ts.tmpl", "target": "src/views/styles.ts", "mode": "render", "kind": "style" },
    { "source": "src/views/favicon.ts.tmpl", "target": "src/views/favicon.ts", "mode": "render", "kind": "source" },
    { "source": "src/config.ts.tmpl", "target": "src/config.ts", "mode": "render", "kind": "source" },
    { "source": "src/app.ts", "target": "src/app.ts", "mode": "copy", "kind": "source" },
    { "source": "src/server.ts", "target": "src/server.ts", "mode": "copy", "kind": "source" },
    { "source": "test/support.ts", "target": "test/support.ts", "mode": "copy", "kind": "test" },
    { "source": "test/router.test.ts", "target": "test/router.test.ts", "mode": "copy", "kind": "test" },
    { "source": "test/routes.test.ts", "target": "test/routes.test.ts", "mode": "copy", "kind": "test" },
    { "source": "test/links.test.ts", "target": "test/links.test.ts", "mode": "copy", "kind": "test" },
    { "source": "test/content.test.ts", "target": "test/content.test.ts", "mode": "copy", "kind": "test" },
    { "source": "README.md.tmpl", "target": "README.md", "mode": "render", "kind": "documentation" }
  ]
}
