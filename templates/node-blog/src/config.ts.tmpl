import type { SiteConfig } from './views/layout.js';

/**
 * Runtime configuration.
 *
 * Identity is generated from the project specification and is safe to edit. The
 * contact address uses the reserved `.example` domain until you replace it.
 */
export const SITE: SiteConfig = {
  title: '{{appTitle}}',
  tagline: '{{tagline}}',
  description:
    '{{siteDescription}}',
};

export const CONTACT_EMAIL = '{{contactEmail}}';

export interface ServerConfig {
  readonly host: string;
  readonly port: number;
  readonly logLevel: 'debug' | 'info' | 'warn' | 'error';
}

const LEVELS = ['debug', 'info', 'warn', 'error'] as const;

export function readServerConfig(env: NodeJS.ProcessEnv = process.env): ServerConfig {
  const rawPort = env['PORT'] ?? '3000';
  const port = Number.parseInt(rawPort, 10);
  if (!Number.isInteger(port) || port < 1 || port > 65_535) {
    throw new Error(`PORT must be an integer between 1 and 65535, received "${rawPort}"`);
  }

  const rawLevel = env['LOG_LEVEL'] ?? 'info';
  if (!LEVELS.includes(rawLevel as (typeof LEVELS)[number])) {
    throw new Error(`LOG_LEVEL must be one of ${LEVELS.join(', ')}, received "${rawLevel}"`);
  }

  return {
    host: env['HOST'] ?? '0.0.0.0',
    port,
    logLevel: rawLevel as (typeof LEVELS)[number],
  };
}
